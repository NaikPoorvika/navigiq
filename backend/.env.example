# Backend specific environment variables
APP_ENV=development
DEBUG=true
DATABASE_URL=postgresql+asyncpg://navigiq_user:navigiq_password@db:5432/navigiq
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# --- LLM (NQ-027/NQ-028) ---------------------------------------------------
# Populated once ADR-012 is Accepted. Until then these are placeholders, not
# defaults: the deterministic /plan path (ADR-002) does not read them, and no
# NQ-028 gateway code should ship with a fallback that makes them optional.
OLLAMA_HOST=http://localhost:11434
# OLLAMA_GEN_MODEL=<set by ADR-012>
# OLLAMA_EMBED_MODEL=<set by ADR-012>
# OLLAMA_EMBED_DIM=<set by ADR-012 - fixes vector(N) in the NQ-034 migration>
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=10m
