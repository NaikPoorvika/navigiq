# Backend specific environment variables
APP_ENV=development
DEBUG=true
DATABASE_URL=postgresql+asyncpg://navigiq_user:navigiq_password@db:5432/navigiq
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# --- LLM (NQ-027/NQ-028) ---------------------------------------------------
# Set by ADR-012 (Accepted 2026-09-13, docs/adr/ADR-012-model-selection.md).
# The deterministic /plan path (ADR-002) does not read these; only the
# NQ-028 gateway, once built, should.
OLLAMA_HOST=http://localhost:11434
OLLAMA_GEN_MODEL=qwen3:14b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_EMBED_DIM=768
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=10m
