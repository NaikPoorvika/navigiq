# NavigIQ API settings. Copy to backend/.env and adjust; .env is never committed.
# Every value here has a safe development default in app/config.py.

# --- runtime -----------------------------------------------------------------------
APP_ENV=development                 # production refuses the development SECRET_KEY
DEBUG=true

# --- database (docker compose publishes Postgres on 5433) ---------------------------
DATABASE_URL=postgresql+asyncpg://navigiq_user:navigiq_password@localhost:5433/navigiq
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- security ------------------------------------------------------------------------
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
MAX_REQUEST_BYTES=256000
# Only needed when the web app is served from another origin. The Vite dev
# server and the nginx container both proxy /api, so none is needed by default.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- cache (optional; everything works without it) -----------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true

# --- geography --------------------------------------------------------------------
BENGALURU_CENTER_LAT=12.9716
BENGALURU_CENTER_LON=77.5946
BENGALURU_DISCOVERY_RADIUS_KM=90
LOCAL_TIMEZONE=Asia/Kolkata

# --- planning -------------------------------------------------------------------
# Transportation is deferred (ADR-022): plans leave this gap between stops and
# never claim a travel time.
TRANSITION_BUFFER_MINUTES=15
TRANSPORTATION_PROVIDER=null

# --- weather (Open-Meteo, no key; plans degrade gracefully when it's down) ---------
WEATHER_ENABLED=true

# --- language model (Ollama on the host; optional) -----------------------------------
# ADR-012: qwen3:14b for language, nomic-embed-text (768-d) for retrieval.
# With LLM_ENABLED=false or Ollama down, NavigIQ uses its rule-based
# understanding; discovery, facts and planning keep working.
LLM_ENABLED=true
OLLAMA_HOST=http://localhost:11434
OLLAMA_GEN_MODEL=qwen3:14b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_EMBED_DIM=768
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=10m
OLLAMA_TIMEOUT_S=60
OLLAMA_MAX_RETRIES=2
LLM_MAX_CONCURRENCY=2
LLM_QUEUE_TIMEOUT_S=30
LLM_BREAKER_THRESHOLD=3
LLM_BREAKER_RESET_S=30
LLM_CACHE_TTL_S=3600

# --- observability ------------------------------------------------------------------
TRACE_RETENTION_DAYS=14

# Where data/ lives (config, curated places, knowledge corpus). Defaults to
# <repo>/data; the container mounts it at /data.
# NAVIGIQ_DATA_DIR=/data
